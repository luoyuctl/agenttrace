Output assets/readme-real-run.gif
Set Shell "bash"
Set FontSize 18
Set Width 1800
Set Height 1100
Set Padding 16
Set Framerate 24
Set Theme "Dracula"
Env TERM "xterm-256color"
Env COLORTERM "truecolor"
Env FORCE_COLOR "1"
Env CLICOLOR_FORCE "1"
Env NO_COLOR ""

Type "agenttrace"
Enter
Sleep 4500ms
Type "!"
Sleep 1200ms
Enter
Sleep 1200ms
Type "l"
Sleep 1200ms
Type "l"
Sleep 1200ms
Escape
Sleep 1200ms
Type "v"
Sleep 1200ms
Escape
Sleep 1200ms
Type "q"
